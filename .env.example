# 環境變數設定範例
# 複製此檔案為 .env 並修改為你的實際路徑

# PDK 根目錄路徑
# 選擇以下其中一種方式:

# 方法 1: 使用 /opt/pdk (推薦用於系統級安裝)
# export PDK_ROOT=/opt/pdk

# 方法 2: 使用 ~/pdk (推薦用於個人安裝)
# export PDK_ROOT=$HOME/pdk

# 方法 3: 使用 volare 安裝的路徑
# export PDK_ROOT=$HOME/.volare/volare/sky130/versions/YOUR_VERSION_HASH

# 方法 4: 自訂路徑
# export PDK_ROOT=/your/custom/path

# 使用方式:
# 在執行模擬前，先 source 這個檔案:
#   source .env
#   ./run_all.sh
